{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "it-pinda",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "it.pinda.kr", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "b09f70c2-deba-4387-8c6c-9f912be61089",
      "database_name": "it-pinda",
      "remote": true
    }
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "it-pinda-media", "remote": true }]
}
